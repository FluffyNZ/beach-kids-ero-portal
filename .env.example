# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side ONLY. Never expose this to the browser.
# Used for admin tasks (e.g. seeding the first login, generating signed URLs
# for private storage). Keep this out of NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the private Supabase Storage bucket used for evidence documents.
NEXT_PUBLIC_EVIDENCE_BUCKET=evidence

# Name of the private Supabase Storage bucket used for policy documents.
NEXT_PUBLIC_POLICIES_BUCKET=policies

# Name of the private Supabase Storage bucket used for staff documents.
NEXT_PUBLIC_STAFF_DOCUMENTS_BUCKET=staff-documents

# Name of the private Supabase Storage bucket used for child profile photos.
NEXT_PUBLIC_CHILD_PHOTOS_BUCKET=child-photos

# Anthropic API key — powers the optional AI features: "Help Me Write" in
# Learning Stories, "Fill from a photo" in Accident & Illness Records, and
# "Read from photo" when uploading a Staff document.
# Get one from https://console.anthropic.com (API Keys section — this is a
# separate, billed API account from a claude.ai subscription). All three
# features work fine without this; they just show a clear "not connected"
# message instead of running, and manual entry always still works.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — overrides the model used for the AI features above. Leave unset
# to use the default (claude-sonnet-5).
# ANTHROPIC_LEARNING_STORY_MODEL=claude-sonnet-5
