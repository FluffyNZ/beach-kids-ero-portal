# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side ONLY. Never expose this to the browser.
# Used for admin tasks (e.g. seeding the first login, generating signed URLs
# for private storage). Keep this out of NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the private Supabase Storage bucket used for evidence documents.
NEXT_PUBLIC_EVIDENCE_BUCKET=evidence

# Name of the private Supabase Storage bucket used for policy documents.
NEXT_PUBLIC_POLICIES_BUCKET=policies

# Name of the private Supabase Storage bucket used for staff documents.
NEXT_PUBLIC_STAFF_DOCUMENTS_BUCKET=staff-documents
